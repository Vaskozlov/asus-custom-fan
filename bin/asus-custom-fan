#!/usr/bin/env bash
set -euo pipefail

SERVICE=asus-custom-fan.service
TOOL=/usr/local/libexec/asus-custom-fan/asus-fan-control-ec
CONFIG=/etc/asus-custom-fan.conf
DAEMON=/usr/local/libexec/asus-custom-fan/fan_curve.py

usage() {
    cat <<USAGE
Usage: asus-custom-fan <command>

Commands:
  status        Show systemd service status
  rpm           Show current EC fan mode and RPM
  logs          Follow service logs
  restart       Restart the fan-curve service
  stop          Stop service and hand control back to EC
  start         Start the fan-curve service
  release       Stop service and explicitly return control to EC
  check-config  Validate configuration and temperature sensor
  config        Edit $CONFIG with \$EDITOR (default: nano/vi)
USAGE
}

cmd=${1:-}
case "$cmd" in
    status)
        systemctl --no-pager --full status "$SERVICE"
        ;;
    rpm)
        sudo "$TOOL" fan-speed
        ;;
    logs)
        journalctl -fu "$SERVICE"
        ;;
    restart)
        sudo systemctl restart "$SERVICE"
        ;;
    stop)
        sudo systemctl stop "$SERVICE"
        ;;
    start)
        sudo systemctl start "$SERVICE"
        ;;
    release)
        sudo systemctl stop "$SERVICE" || true
        sudo "$TOOL" setp -1
        ;;
    check-config)
        "$DAEMON" --config "$CONFIG" --check
        ;;
    config)
        editor=${EDITOR:-}
        if [[ -z "$editor" ]]; then
            if command -v nano >/dev/null 2>&1; then editor=nano; else editor=vi; fi
        fi
        sudo "$editor" "$CONFIG"
        echo "Restarting $SERVICE..."
        sudo systemctl restart "$SERVICE"
        ;;
    *)
        usage
        exit 2
        ;;
esac
